<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS"
         xmlns:xs="http://www.w3.org/2001/XMLSchema"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>Requisitos de ejemplo GuBIM</ids:title>
    <ids:version>1.0</ids:version>
    <ids:author>info@gubim.gal</ids:author>
    <ids:date>2026-10-17</ids:date>
    <ids:description>IDS de demostración para el modelo ejemplo-basico.ifc. Incluye requisitos que se cumplen y otros que no, para mostrar el flujo de revisión.</ids:description>
    <ids:milestone>Proyecto de ejecución</ids:milestone>
  </ids:info>
  <ids:specifications>

    <ids:specification name="Muros con resistencia al fuego" ifcVersion="IFC2X3 IFC4" identifier="ARQ-01"
                       description="Todos los muros deben declarar su resistencia al fuego EI 120."
                       instructions="Rellenar Pset_WallCommon.FireRating en la herramienta de autoría.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" cardinality="required">
          <ids:propertySet><ids:simpleValue>Pset_WallCommon</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>FireRating</ids:simpleValue></ids:baseName>
          <ids:value><ids:simpleValue>EI 120</ids:simpleValue></ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Muros exteriores identificados" ifcVersion="IFC2X3 IFC4" identifier="ARQ-02">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet><ids:simpleValue>Pset_WallCommon</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>IsExternal</ids:simpleValue></ids:baseName>
          <ids:value><ids:simpleValue>true</ids:simpleValue></ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Transmitancia térmica de ventanas" ifcVersion="IFC2X3 IFC4" identifier="ENE-01"
                       description="Las ventanas deben indicar su transmitancia térmica (U) para la justificación del CTE DB-HE.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWINDOW</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCTHERMALTRANSMITTANCEMEASURE" cardinality="required">
          <ids:propertySet><ids:simpleValue>Pset_WindowCommon</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>ThermalTransmittance</ids:simpleValue></ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Estructura de hormigón" ifcVersion="IFC2X3 IFC4" identifier="EST-01"
                       description="Pilares y forjados deben tener asignado un material de hormigón.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCCOLUMN"/>
              <xs:enumeration value="IFCSLAB"/>
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:material cardinality="required">
          <ids:value><xs:restriction base="xs:string"><xs:pattern value="Hormig.*"/></xs:restriction></ids:value>
        </ids:material>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Espesor de muros entre 20 y 30 cm" ifcVersion="IFC2X3 IFC4" identifier="ARQ-03">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLENGTHMEASURE" cardinality="required">
          <ids:propertySet><ids:simpleValue>Qto_WallBaseQuantities</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>Width</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:double">
              <xs:minInclusive value="0.2"/>
              <xs:maxInclusive value="0.3"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Forjados asignados a una planta" ifcVersion="IFC2X3 IFC4" identifier="COO-01">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCSLAB</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:partOf relation="IFCRELCONTAINEDINSPATIALSTRUCTURE" cardinality="required">
          <ids:entity><ids:name><ids:simpleValue>IFCBUILDINGSTOREY</ids:simpleValue></ids:name></ids:entity>
        </ids:partOf>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Clasificación Uniclass de muros" ifcVersion="IFC2X3 IFC4" identifier="COO-02"
                       description="Los muros deben clasificarse con Uniclass 2015 (tabla EF).">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:classification cardinality="required">
          <ids:value><xs:restriction base="xs:string"><xs:pattern value="EF_25_.*"/></xs:restriction></ids:value>
          <ids:system><ids:simpleValue>Uniclass 2015</ids:simpleValue></ids:system>
        </ids:classification>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Código de muro (Tag)" ifcVersion="IFC2X3 IFC4" identifier="COO-03"
                       description="El atributo Tag sigue el formato M-NN.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALL</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name><ids:simpleValue>Tag</ids:simpleValue></ids:name>
          <ids:value><xs:restriction base="xs:string"><xs:pattern value="M-[0-9]{2}"/></xs:restriction></ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Sin elementos proxy" ifcVersion="IFC2X3 IFC4" identifier="COO-04"
                       description="No se admiten IfcBuildingElementProxy: todo elemento debe tener su clase IFC correcta.">
      <ids:applicability minOccurs="0" maxOccurs="0">
        <ids:entity><ids:name><ids:simpleValue>IFCBUILDINGELEMENTPROXY</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
    </ids:specification>

    <ids:specification name="Puertas con nombre" ifcVersion="IFC2X3 IFC4" identifier="ARQ-04"
                       description="El modelo debe contener puertas y todas deben tener nombre.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCDOOR</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required">
          <ids:name><ids:simpleValue>Name</ids:simpleValue></ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Pilares portantes" ifcVersion="IFC2X3 IFC4" identifier="EST-02">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name><ids:simpleValue>IFCCOLUMN</ids:simpleValue></ids:name>
          <ids:predefinedType><ids:simpleValue>COLUMN</ids:simpleValue></ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCBOOLEAN" cardinality="required">
          <ids:propertySet><ids:simpleValue>Pset_ColumnCommon</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>LoadBearing</ids:simpleValue></ids:baseName>
          <ids:value><ids:simpleValue>true</ids:simpleValue></ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Concello en datos GuBIM" ifcVersion="IFC2X3 IFC4" identifier="GUB-01"
                       description="Si un elemento tiene el Pset GuBIM_Datos, debe indicar el concello.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:property>
          <ids:propertySet><ids:simpleValue>GuBIM_Datos</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>Fase</ids:simpleValue></ids:baseName>
        </ids:property>
      </ids:applicability>
      <ids:requirements>
        <ids:property cardinality="required">
          <ids:propertySet><ids:simpleValue>GuBIM_Datos</ids:simpleValue></ids:propertySet>
          <ids:baseName><ids:simpleValue>Concello</ids:simpleValue></ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Santiago de Compostela"/>
              <xs:enumeration value="A Coruña"/>
              <xs:enumeration value="Vigo"/>
            </xs:restriction>
          </ids:value>
        </ids:property>
      </ids:requirements>
    </ids:specification>

    <ids:specification name="Requisito solo para IFC2X3" ifcVersion="IFC2X3" identifier="LEG-01"
                       description="Ejemplo de especificación que no aplica a modelos IFC4.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity><ids:name><ids:simpleValue>IFCWALLSTANDARDCASE</ids:simpleValue></ids:name></ids:entity>
      </ids:applicability>
    </ids:specification>

  </ids:specifications>
</ids:ids>
