# ─────────────────────────────────────────────
# VisorGuBIMGal — .gitignore
# ─────────────────────────────────────────────

# ── Dependencias ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build / Dist ──────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Caché de Vite ─────────────────────────────
.vite/
.vite-inspect/

# ── Cobertura de Tests ────────────────────────
coverage/
.nyc_output/

# ── Playwright ────────────────────────────────
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── Variables de Entorno ──────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Sistema Operativo ─────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── IDEs y Editores ───────────────────────────
# VSCode (se mantienen settings de workspace si los hubiera en .vscode/settings.json)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws

# ── TypeScript ────────────────────────────────
*.tsbuildinfo

# ── Archivos temporales ───────────────────────
*.tmp
*.temp
*.swp
*.swo
*~

# ── Modelos BIM grandes (no versionar en git) ─
# Los ficheros IFC de muestra de gran tamaño deben
# almacenarse en Git LFS o distribuirse por separado.
public/sample-models/*.ifc
public/sample-models/*.ifczip

# ── Assets de desarrollo ──────────────────────
*.local

# ── Lockfiles alternativos ────────────────────
# Mantener solo el lockfile del gestor de paquetes elegido.
# Descomentar el que NO se use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
